<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Group-specific ir.rules are OR'd together.
        Settings Admin must bypass ACIU member restrictions.
    -->
    <record id="rule_aciu_system_all_partners" model="ir.rule">
        <field name="name">ACIU System Admin: all partners</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
        Company contacts (e.g. ACIU Germany partner) are needed when opening
        member forms (commercial entity / company partner_id). Central roles
        already cover them via child_of; keep an explicit OR for clarity.
    -->
    <record id="rule_aciu_central_company_partners" model="ir.rule">
        <field name="name">ACIU Central: company contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id', 'in', user.company_ids.partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('aciu_base.group_aciu_central_executive')), (4, ref('aciu_base.group_aciu_central_treasurer'))]"/>
    </record>

    <!-- Own contact + parent branch company contact (Contacts hierarchy) -->
    <record id="rule_aciu_member_own_partner" model="ir.rule">
        <field name="name">ACIU Member: own partner and branch contact</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', ('id', '=', user.partner_id.id), ('id', 'parent_of', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('aciu_base.group_aciu_member'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Branch officers: only own-branch members + that branch's contact tree -->
    <record id="rule_aciu_branch_officer_partners" model="ir.rule">
        <field name="name">ACIU Branch officer: own branch contacts only</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', ('aciu_branch_id', 'in', company_ids), ('id', 'child_of', user.company_ids.filtered(lambda c: c.id in company_ids).partner_id.ids)]</field>
        <field name="groups" eval="[
            (4, ref('aciu_base.group_aciu_branch_treasurer')),
            (4, ref('aciu_base.group_aciu_branch_financial_secretary')),
            (4, ref('aciu_base.group_aciu_branch_secretary')),
            (4, ref('aciu_base.group_aciu_branch_speaker')),
            (4, ref('aciu_base.group_aciu_branch_vice_president')),
            (4, ref('aciu_base.group_aciu_branch_leader')),
        ]"/>
    </record>

    <!-- Central roles: all ACIU members + company contacts -->
    <record id="rule_aciu_central_partners" model="ir.rule">
        <field name="name">ACIU Central: all ACIU members</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', '|', ('is_aciu_member', '=', True), ('aciu_branch_id', '!=', False), ('id', 'child_of', user.company_ids.partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('aciu_base.group_aciu_central_executive')), (4, ref('aciu_base.group_aciu_central_treasurer'))]"/>
    </record>
</odoo>
