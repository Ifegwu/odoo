<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_aciu" model="ir.module.category">
        <field name="name">ACIU</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_aciu" model="res.groups.privilege">
        <field name="name">ACIU</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_aciu"/>
    </record>

    <!-- Members: limited R/W on own areas; not Settings/Admin -->
    <record id="group_aciu_member" model="res.groups">
        <field name="name">Member</field>
        <field name="sequence">10</field>
        <field name="comment">Read/write own profile, payments and attendance. No bank or Settings access.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Branch officers (read own branch); President also writes own branch -->
    <record id="group_aciu_branch_treasurer" model="res.groups">
        <field name="name">Treasurer</field>
        <field name="sequence">20</field>
        <field name="comment">Branch treasurer: read own branch; finance write on dues/bank. Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <record id="group_aciu_branch_financial_secretary" model="res.groups">
        <field name="name">Financial Secretary</field>
        <field name="sequence">22</field>
        <field name="comment">Branch financial secretary: read own branch. Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <record id="group_aciu_branch_secretary" model="res.groups">
        <field name="name">Secretary</field>
        <field name="sequence">24</field>
        <field name="comment">Branch secretary: read own branch. Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <record id="group_aciu_branch_speaker" model="res.groups">
        <field name="name">Speaker</field>
        <field name="sequence">26</field>
        <field name="comment">Branch speaker: read own branch. Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <record id="group_aciu_branch_vice_president" model="res.groups">
        <field name="name">Vice President</field>
        <field name="sequence">28</field>
        <field name="comment">Branch vice president: read own branch. Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <!-- xml id kept as group_aciu_branch_leader for existing assignments -->
    <record id="group_aciu_branch_leader" model="res.groups">
        <field name="name">President</field>
        <field name="sequence">30</field>
        <field name="comment">Branch president: read/write own branch (members, roll call, projects). Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <record id="group_aciu_central_treasurer" model="res.groups">
        <field name="name">Central Treasurer</field>
        <field name="sequence">40</field>
        <field name="comment">Central bank and consolidated DE finance view. Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <record id="group_aciu_central_executive" model="res.groups">
        <field name="name">Central Executive</field>
        <field name="sequence">50</field>
        <field name="comment">Germany-wide operational access. Central executives remain branch members and keep any branch title (Treasurer, President, VP, etc.); they perform both central and branch functions. Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <!--
      Branch officers stay on company_ids only (no parent Germany read).
      Avoid parent_id in branch lists/forms so the UI does not fetch Central.
    -->
    <record id="res_company_rule_aciu_president_write" model="ir.rule">
        <field name="name">ACIU president: write own branch company</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="groups" eval="[(4, ref('group_aciu_branch_leader'))]"/>
        <field name="domain_force">[('id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="res_company_rule_aciu_central_read_all" model="ir.rule">
        <field name="name">ACIU central: read all ACIU companies</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="groups" eval="[(4, ref('group_aciu_central_executive')), (4, ref('group_aciu_central_treasurer'))]"/>
        <field name="domain_force">[('is_aciu_company', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="res_company_rule_aciu_central_exec_write" model="ir.rule">
        <field name="name">ACIU central executive: write all ACIU companies</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="groups" eval="[(4, ref('group_aciu_central_executive'))]"/>
        <field name="domain_force">[('is_aciu_company', '=', True)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
