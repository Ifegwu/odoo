<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_aciu" model="ir.module.category">
        <field name="name">ACIU</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_aciu" model="res.groups.privilege">
        <field name="name">ACIU</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_aciu"/>
    </record>

    <!-- Members: limited R/W on own areas; not Settings/Admin -->
    <record id="group_aciu_member" model="res.groups">
        <field name="name">Member</field>
        <field name="sequence">10</field>
        <field name="comment">Read/write own profile, payments and attendance. No bank or Settings access.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_aciu_branch_treasurer" model="res.groups">
        <field name="name">Branch Treasurer</field>
        <field name="sequence">20</field>
        <field name="comment">Own branch bank, fees and levies. Elevated finance; not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <record id="group_aciu_branch_leader" model="res.groups">
        <field name="name">Branch Leader</field>
        <field name="sequence">30</field>
        <field name="comment">Own branch members, roll call and projects. Elevated ops; not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <record id="group_aciu_central_treasurer" model="res.groups">
        <field name="name">Central Treasurer</field>
        <field name="sequence">40</field>
        <field name="comment">Central bank and consolidated DE finance view. Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>

    <record id="group_aciu_central_executive" model="res.groups">
        <field name="name">Central Executive</field>
        <field name="sequence">50</field>
        <field name="comment">Germany-wide operational access. Not Settings/Admin.</field>
        <field name="privilege_id" ref="res_groups_privilege_aciu"/>
        <field name="implied_ids" eval="[(4, ref('group_aciu_member'))]"/>
    </record>
</odoo>
