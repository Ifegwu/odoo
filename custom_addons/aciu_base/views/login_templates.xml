<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Frosted card + body class for full-bleed bg-login.jpeg -->
    <template id="login_layout_aciu" inherit_id="web.login_layout" name="ACIU Login Layout" priority="99">
        <xpath expr="//t[@t-set='body_classname']" position="replace">
            <t t-set="body_classname" t-value="'aciu_login_body'"/>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class">container aciu_login_container py-4 py-md-5</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_database_list')]" position="attributes">
            <attribute name="class">card border-0 mx-auto aciu_login_card o_database_list</attribute>
            <attribute name="style">max-width: 360px;</attribute>
        </xpath>
    </template>
</odoo>
