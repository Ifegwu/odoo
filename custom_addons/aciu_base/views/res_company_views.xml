<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_aciu" model="ir.ui.view">
        <field name="name">res.company.form.aciu</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="ACIU" name="aciu" invisible="not is_aciu_company">
                    <group>
                        <group string="Branch">
                            <field name="is_aciu_company"/>
                            <field name="aciu_branch_code"/>
                            <field name="is_registered_ev"/>
                            <field name="aciu_vr_number" invisible="not is_registered_ev"/>
                        </group>
                        <group string="Roll call">
                            <field name="roll_call_fee_amount"/>
                        </group>
                    </group>
                </page>
                <page string="ACIU" name="aciu_enable" invisible="is_aciu_company">
                    <group>
                        <field name="is_aciu_company"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_company_tree_aciu" model="ir.ui.view">
        <field name="name">res.company.list.aciu</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <list string="ACIU Companies">
                <field name="name"/>
                <field name="aciu_branch_code"/>
                <field name="parent_id"/>
                <field name="is_registered_ev"/>
                <field name="roll_call_fee_amount"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_aciu_companies" model="ir.actions.act_window">
        <field name="name">Branches &amp; Central</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_aciu_company', '=', True)]</field>
        <field name="context">{'default_is_aciu_company': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_company_tree_aciu')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_company_form')})]"/>
    </record>
</odoo>
