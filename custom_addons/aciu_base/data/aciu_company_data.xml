            <field name="partner_id" ref="partner_aciu_bremen"/>
            <field name="parent_id" ref="company_aciu_germany"/>
            <field name="currency_id" ref="base.EUR"/>
            <field name="is_aciu_company" eval="True"/>
            <field name="is_registered_ev" eval="False"/>
            <field name="aciu_branch_code">DE-HB</field>
        </record>

