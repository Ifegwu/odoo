<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Currency / country refs: base.EUR, base.de -->

        <!-- ACIU Germany (central e.V.) -->
        <record id="partner_aciu_germany" model="res.partner">
            <field name="name">ACIU Germany</field>
            <field name="is_company" eval="True"/>
            <field name="country_id" ref="base.de"/>
            <field name="email">germany@aciu.example</field>
        </record>
        <record id="company_aciu_germany" model="res.company">
            <field name="name">ACIU Germany</field>
            <field name="partner_id" ref="partner_aciu_germany"/>
            <field name="currency_id" ref="base.EUR"/>
            <field name="is_aciu_company" eval="True"/>
            <field name="is_registered_ev" eval="True"/>
            <field name="aciu_branch_code">DE-CENTRAL</field>
            <field name="roll_call_fee_amount">0</field>
        </record>

        <!-- 1 Bremen -->
        <record id="partner_aciu_bremen" model="res.partner">
