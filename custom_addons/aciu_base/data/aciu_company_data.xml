        <!-- Give admin access to all ACIU companies -->
        <function model="res.users" name="write">
            <value eval="[ref('base.user_admin')]"/>
            <value eval="{
                'company_ids': [
                    (4, ref('company_aciu_germany')),
                    (4, ref('company_aciu_bremen')),
                    (4, ref('company_aciu_hamburg')),
                    (4, ref('company_aciu_bayern')),
                    (4, ref('company_aciu_bw')),
                    (4, ref('company_aciu_nrw')),
                    (4, ref('company_aciu_duisburg')),
                    (4, ref('company_aciu_halle')),
                    (4, ref('company_aciu_osnabruck')),
                    (4, ref('company_aciu_berlin')),
                    (4, ref('company_aciu_frankfurt')),
                    (4, ref('company_aciu_hannover')),
                ],
            }"/>
        </function>
