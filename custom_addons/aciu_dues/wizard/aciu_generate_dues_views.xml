<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aciu_generate_dues_wizard" model="ir.ui.view">
        <field name="name">aciu.generate.dues.wizard.form</field>
        <field name="model">aciu.generate.dues.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Dues">
                <group>
                    <field name="dues_type"/>
                    <field name="company_id"/>
                    <field name="invoice_date"/>
                    <field name="member_ids" widget="many2many_tags"
                            options="{'no_create': True, 'no_create_edit': True}"
                            placeholder="Select members (or change Branch / Company)"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate Invoices" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_aciu_generate_dues" model="ir.actions.act_window">
        <field name="name">Generate Dues Invoices</field>
        <field name="res_model">aciu.generate.dues.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
