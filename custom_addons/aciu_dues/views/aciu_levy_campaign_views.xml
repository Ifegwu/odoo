<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aciu_levy_campaign_list" model="ir.ui.view">
        <field name="name">aciu.levy.campaign.list</field>
        <field name="model">aciu.levy.campaign</field>
        <field name="arch" type="xml">
            <list string="Campaigns">
                <field name="name"/>
                <field name="contribution_type"/>
                <field name="company_id"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="view_aciu_levy_campaign_form" model="ir.ui.view">
        <field name="name">aciu.levy.campaign.form</field>
        <field name="model">aciu.levy.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaign">
                <header>
                    <button name="action_open" type="object" string="Open" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'open'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        For <strong>Annual Membership Due (€20)</strong> and
                        <strong>Monthly Roll-Call Fee</strong>, use
                        <em>ACIU → Dues &amp; Collections → Generate Dues Invoices</em>.
                        This form is only for branch/central projects and burial levies.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contribution_type"/>
                            <field name="company_id"/>
                            <field name="product_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="soft_debt_policy"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Context for burial or project…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aciu_levy_campaign" model="ir.actions.act_window">
        <field name="name">Projects &amp; Burial Levies</field>
        <field name="res_model">aciu.levy.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
