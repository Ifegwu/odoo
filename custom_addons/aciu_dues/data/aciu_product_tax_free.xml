<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Force tax-free on every module update (noupdate=0): chart install often re-applies default VAT -->
    <data noupdate="0">
        <record id="product_aciu_annual_due" model="product.product">
            <field name="taxes_id" eval="[(5,)]"/>
            <field name="supplier_taxes_id" eval="[(5,)]"/>
        </record>
        <record id="product_aciu_roll_call_fee" model="product.product">
            <field name="taxes_id" eval="[(5,)]"/>
            <field name="supplier_taxes_id" eval="[(5,)]"/>
        </record>
        <record id="product_aciu_burial_levy" model="product.product">
            <field name="taxes_id" eval="[(5,)]"/>
            <field name="supplier_taxes_id" eval="[(5,)]"/>
        </record>
        <record id="product_aciu_branch_project" model="product.product">
            <field name="taxes_id" eval="[(5,)]"/>
            <field name="supplier_taxes_id" eval="[(5,)]"/>
        </record>
        <record id="product_aciu_central_project" model="product.product">
            <field name="taxes_id" eval="[(5,)]"/>
            <field name="supplier_taxes_id" eval="[(5,)]"/>
        </record>
    </data>
</odoo>
